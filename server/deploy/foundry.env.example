# Optional launcher environment; contains no secrets and is not auto-loaded.
# Set these in your owned Foundry terminal before invoking run-foundry.sh.
NW_BIND=192.168.1.181
NW_PORT=29383
NW_CERT=secrets/dtls/rep-server.crt
NW_KEY=secrets/dtls/rep-server.key
NW_LOG_DIR=logs
NW_LOG_MAX_BYTES=5000000
NW_LOG_BACKUPS=4
